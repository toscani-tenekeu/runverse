# Copy to .env and adjust. See README.md for every setting.
RUNVERSE_PORT=8085
RUNVERSE_BIND=0.0.0.0
# true also serves the project's landing page at / (not needed for self-hosting)
RUNVERSE_LANDING=false
# Sign-in is ON by default. This only sets the starting state the first time Runverse runs;
# after that use ./scripts/auth.sh on|off|reset (see README).
RUNVERSE_AUTH=true
RUN_TIMEOUT_MS=3000
PISTON_MEMORY=3g
PISTON_CPUS=2
MAX_CONCURRENT_RUNS=4
MEMORY_LIMIT_BYTES=536870912
RUNS_PER_MINUTE=30
SHARES_PER_HOUR=20
